{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "openmarkets.public-settings"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "settings": {
      "type": "object",
      "properties": {
        "storefront": {
          "type": "object",
          "properties": {
            "theme": {
              "type": "string",
              "enum": [
                "day-market",
                "night-market"
              ]
            },
            "layout": {
              "type": "string",
              "enum": [
                "grid",
                "list"
              ]
            },
            "tokens": {
              "type": "object",
              "properties": {
                "accent": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              },
              "additionalProperties": {}
            }
          },
          "additionalProperties": {}
        },
        "merchant": {
          "type": "object",
          "properties": {
            "generalLocation": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "location": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 240
                    },
                    "geohash": {
                      "type": "string",
                      "pattern": "^[0123456789bcdefghjkmnpqrstuvwxyz]{4}$"
                    }
                  },
                  "required": [
                    "location"
                  ],
                  "additionalProperties": {}
                },
                {
                  "type": "null"
                }
              ]
            },
            "businessHours": {
              "type": "object",
              "properties": {
                "timezone": {
                  "type": "string",
                  "maxLength": 80
                },
                "weekly": {
                  "type": "object",
                  "properties": {
                    "mon": {
                      "maxItems": 8,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "start": {
                            "type": "string",
                            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                          },
                          "end": {
                            "type": "string",
                            "pattern": "^(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]|24:00)$"
                          }
                        },
                        "required": [
                          "start",
                          "end"
                        ],
                        "additionalProperties": {}
                      }
                    },
                    "tue": {
                      "maxItems": 8,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "start": {
                            "type": "string",
                            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                          },
                          "end": {
                            "type": "string",
                            "pattern": "^(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]|24:00)$"
                          }
                        },
                        "required": [
                          "start",
                          "end"
                        ],
                        "additionalProperties": {}
                      }
                    },
                    "wed": {
                      "maxItems": 8,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "start": {
                            "type": "string",
                            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                          },
                          "end": {
                            "type": "string",
                            "pattern": "^(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]|24:00)$"
                          }
                        },
                        "required": [
                          "start",
                          "end"
                        ],
                        "additionalProperties": {}
                      }
                    },
                    "thu": {
                      "maxItems": 8,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "start": {
                            "type": "string",
                            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                          },
                          "end": {
                            "type": "string",
                            "pattern": "^(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]|24:00)$"
                          }
                        },
                        "required": [
                          "start",
                          "end"
                        ],
                        "additionalProperties": {}
                      }
                    },
                    "fri": {
                      "maxItems": 8,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "start": {
                            "type": "string",
                            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                          },
                          "end": {
                            "type": "string",
                            "pattern": "^(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]|24:00)$"
                          }
                        },
                        "required": [
                          "start",
                          "end"
                        ],
                        "additionalProperties": {}
                      }
                    },
                    "sat": {
                      "maxItems": 8,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "start": {
                            "type": "string",
                            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                          },
                          "end": {
                            "type": "string",
                            "pattern": "^(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]|24:00)$"
                          }
                        },
                        "required": [
                          "start",
                          "end"
                        ],
                        "additionalProperties": {}
                      }
                    },
                    "sun": {
                      "maxItems": 8,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "start": {
                            "type": "string",
                            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                          },
                          "end": {
                            "type": "string",
                            "pattern": "^(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]|24:00)$"
                          }
                        },
                        "required": [
                          "start",
                          "end"
                        ],
                        "additionalProperties": {}
                      }
                    }
                  },
                  "additionalProperties": {}
                },
                "exceptions": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "additionalProperties": {
                    "maxItems": 8,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "start": {
                          "type": "string",
                          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                        },
                        "end": {
                          "type": "string",
                          "pattern": "^(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]|24:00)$"
                        }
                      },
                      "required": [
                        "start",
                        "end"
                      ],
                      "additionalProperties": {}
                    }
                  }
                }
              },
              "required": [
                "timezone",
                "weekly"
              ],
              "additionalProperties": {}
            },
            "serviceLanguages": {
              "maxItems": 32,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$",
                "maxLength": 64
              }
            },
            "notice": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 2000
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": {}
        },
        "shipping": {
          "type": "object",
          "properties": {
            "defaultPolicy": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^30406:[0-9a-f]{64}:.+$",
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "defaultPolicy"
          ],
          "additionalProperties": {}
        }
      },
      "additionalProperties": {}
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "data": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": [
          "version",
          "data"
        ],
        "additionalProperties": {}
      },
      "maxProperties": 16
    }
  },
  "required": [
    "format",
    "version",
    "settings"
  ],
  "additionalProperties": {},
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    },
    "bounded": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 4096,
          "not": {
            "const": "openmarkets.private-settings"
          }
        },
        {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/bounded"
          }
        },
        {
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {
            "maxLength": 128,
            "not": {
              "enum": [
                "__proto__",
                "prototype",
                "constructor",
                "visibility",
                "mnemonic",
                "seed",
                "nsec",
                "privateKey",
                "walletId",
                "wallets",
                "walletRecords",
                "recovery",
                "defaultWalletId",
                "paySelectedAt",
                "receiveSelectedAt",
                "credentials",
                "nwcUri",
                "rates",
                "countries",
                "restrictTo",
                "exclude",
                "originCountry",
                "price",
                "weightBands",
                "display",
                "appearance",
                "notifications",
                "working",
                "payments",
                "savedAddresses",
                "defaultAddressId",
                "recipientName",
                "addressLine1",
                "addressLine2",
                "postalCode",
                "email",
                "phone",
                "preferredMethod"
              ]
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/bounded"
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/bounded"
    }
  ]
}
